# Copie para .env e preencha SOMENTE quando o projeto Supabase for provisionado (a partir da T1.3/T1.4).
# Nesta etapa (T1.1) nenhuma variável é necessária.
#
# Use APENAS a chave pública (anon/publishable). NUNCA coloque a service_role key aqui.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

